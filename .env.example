# ------------------------------------------------------------------------------
# 2. SERVIDOR PRIVADO (Backend Node/Express - NUNCA expor ao navegador)
# ------------------------------------------------------------------------------

# [OPCIONAL] [PRIVADO] [VALOR PADRÃO: 3000] Porta de execução do servidor Express
PORT=3000

# [OPCIONAL/RECOMENDADO] [PRIVADO] Chave de API do Gemini para resumos e recomendações inteligentes de IA
GEMINI_API_KEY=

# [OPCIONAL] [PRIVADO] Chave de API do Google Books (aumenta o limite de requisições de busca)
GOOGLE_BOOKS_API_KEY=

# [OPCIONAL] [PRIVADO] [VALOR PADRÃO: false] Ativar funcionalidade de e-mail real via SMTP (true/false)
EMAIL_ENABLED=false

# [CONDICIONAL] [PRIVADO] Conta de e-mail de envio (Obrigatório apenas se EMAIL_ENABLED=true)
EMAIL_USER=

# [CONDICIONAL] [PRIVADO] Senha de aplicativo SMTP (Obrigatório apenas se EMAIL_ENABLED=true)
EMAIL_PASS=
